MCE_TEST_DATABASE_URL=postgresql+psycopg://test_user:replace_me@localhost:5432/mce_test
MCE_DATABASE_URL=postgresql+psycopg://mce_user:replace_me@localhost:5432/mce
TMDB_API_KEY=replace_with_your_tmdb_api_key
TAVILY_API_KEY=replace_with_your_tavily_api_key
SERPER_API_KEY=replace_with_your_serper_api_key
EXA_API_KEY=replace_with_your_exa_api_key
GROQ_API_KEY=replace_with_your_groq_api_key
FANART_API_KEY=replace_with_your_fanart_api_key
MCE_TAVILY_ENABLED=true
MCE_SERPER_ENABLED=true
MCE_EXA_ENABLED=true
MCE_TAVILY_PRIORITY=30
MCE_SERPER_PRIORITY=20
MCE_EXA_PRIORITY=10
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_MAX_WEB_RESULTS=5
LOCAL_LLM_MAX_CONTEXT_CHARS=8000
LOCAL_LLM_MAX_OUTPUT_TOKENS=800
LOCAL_LLM_CIRCUIT_FAILURE_THRESHOLD=3
LOCAL_LLM_CIRCUIT_COOLDOWN_SECONDS=60
MCE_METADATA_LANGUAGE=es-ES
MCE_METADATA_REGION=CU
MCE_METADATA_TIMEOUT_SECONDS=10
MCE_METADATA_RETRIES=2
MCE_METADATA_RETRY_DELAY_SECONDS=0.5
MCE_METADATA_MAX_REQUESTS=5000
MCE_METADATA_CACHE_TTL_HOURS=24
MCE_METADATA_CACHE_MAX_ENTRIES=5000
MCE_OFFLINE=false
