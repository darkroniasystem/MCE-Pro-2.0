# MCE Pro 2.0 - Environment Variables
# Copia este archivo a .env y completa las credenciales

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mce_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_STAGING=mce_staging
POSTGRES_DB_CACHE=mce_cache
POSTGRES_DB_MASTER=mce_master
POSTGRES_DB_APP=mce_app

# API Keys (extraer del MCE legacy)
TMDB_API_KEY=CHANGE_ME
ANILIST_CLIENT_ID=CHANGE_ME
ANILIST_CLIENT_SECRET=CHANGE_ME
TAVILY_API_KEY=CHANGE_ME
SERPER_API_KEY=CHANGE_ME
EXA_API_KEY=CHANGE_ME
GROQ_API_KEY=CHANGE_ME

# Ollama (Qwen local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Telegram Bot (futuro)
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_URL=

# Workers
VALIDATE_WORKERS=4
PREPARE_WORKERS=6
ENRICH_WORKERS=3
PUBLISHER_WORKERS=1
AI_WORKERS=1

# Rate Limits
TMDB_RATE_LIMIT=500
GROQ_RATE_LIMIT=1000
TAVILY_RATE_LIMIT=200
SERPER_RATE_LIMIT=100
EXA_RATE_LIMIT=100
